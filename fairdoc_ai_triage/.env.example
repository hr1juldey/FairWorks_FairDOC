# fairdoc AI Triage System - Environment Configuration

# Application Settings
APP_NAME="fairdoc AI Triage System"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
DATABASE_URL=postgresql://fairdoc_user:fairdoc_secure_pass@localhost:5432/fairdoc_ai
TEST_DATABASE_URL=postgresql://fairdoc_user:fairdoc_secure_pass@localhost:5432/fairdoc_ai_test

# Redis Configuration
REDIS_URL=redis://:redis_fairdoc_pass@localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fairdoc_minio
MINIO_SECRET_KEY=fairdoc_minio_secure_key
MINIO_BUCKET_NAME=fairdoc-ai-storage

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
DSPY_LM_TYPE=ollama
DSPY_MODEL_NAME=deepseek-r1:8b

# Raven Chat Integration
RAVEN_WEBHOOK_URL=http://localhost:8080/api/method/raven.api.raven_message
RAVEN_API_KEY=your-raven-api-key-here
RAVEN_SECRET=your-raven-webhook-secret

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_ENDPOINT=localhost:9090

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Celery Configuration
CELERY_BROKER_URL=redis://:redis_fairdoc_pass@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_fairdoc_pass@localhost:6379/2
